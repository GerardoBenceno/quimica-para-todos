{
  "name": "quimica-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "validate": "tsx scripts/validate-content.ts",
    "sync:base": "tsx scripts/sync-base.ts",
    "predev": "tsx scripts/sync-base.ts && tsx scripts/copy-vendor.ts",
    "prebuild": "tsx scripts/sync-base.ts && tsx scripts/copy-vendor.ts",
    "pretest": "tsx scripts/sync-base.ts && tsx scripts/copy-vendor.ts",
    "verify": "node scripts/verify-prod.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-math": "5.3.0",
    "@rdkit/rdkit": "2026.9.1",
    "3dmol": "2.5.5",
    "events": "3.3.0",
    "ketcher-core": "3.18.0",
    "ketcher-react": "3.18.0",
    "ketcher-standalone": "3.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
